/*
 * jkcare application devicetree overlay.
 *
 * UART0 and I2C0 are board-level hardware and are defined in
 * boards/ambiq/jkcare_apollo4p_blue/jkcare_apollo4p_blue.dts.
 * Add application-specific peripherals here later.
 */

#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	/*
	 * Temporary GPIO assignments; update these two pin numbers according
	 * to the JKCare schematic.
	 */
	zephyr,user {
		led-gpios = <&gpio0_31 7 GPIO_ACTIVE_HIGH>;
		touch-gpios = <&gpio0_31 8 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>;
	};
};

&i2c0 {
    status = "okay";

    sht4x: sht4x@44 {
        compatible = "sensirion,sht4x";
        reg = <0x44>;
        repeatability = <2>;
        status = "okay";
    };

	/*
	 * Example out-of-tree sensor driver. CHT8305C defaults to 0x40 when
	 * AD0 is connected to GND or left floating.
	 */
	cht8305c: humidity-sensor@40 {
		compatible = "sensylink,cht8305c";
		reg = <0x40>;
		status = "okay";
	};
};
